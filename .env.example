# ===== 必填 =====
# 你的 OpenCode Go API 密钥（从 https://opencode.ai/auth 获取）
GO_API_KEY=sk-xxxx

# 管理密钥（访问 /admin/* API 和 Web 控制台）
# 不设置则启动时自动生成并在日志中打印一次
ADMIN_API_KEY=

# ===== 可选 =====
# 上游 OpenCode Go 网关地址（一般不需要改）
GO_BASE_URL=https://opencode.ai/zen/go/v1

# 端口（Railway 会自动注入 PORT）
PORT=3000

# 数据库文件路径（Railway 上建议挂持久卷后指向卷内，如 /data/go2api.db）
DB_PATH=./data/go2api.db

# 全局模型白名单（逗号分隔，留空 = 全部模型可用）
# 例: ENABLED_MODELS=deepseek-v4-flash,deepseek-v4-pro,kimi-k2.6
ENABLED_MODELS=

# 新订阅默认美元额度（0 = 不限）
DEFAULT_QUOTA_USD=0

# 新订阅默认每分钟请求数上限（0 = 不限）
DEFAULT_RPM=0
